# JIPSA 환경변수 템플릿
#
# 사용법: cp .env.example .env 후 값을 채운다. `.env` 는 gitignore 처리돼 있다.
# 이 파일에는 **값을 절대 넣지 말 것** — 키 이름과 설명만 둔다.
#
# ⚠️ 스크립트·데몬은 dotenv 를 쓰지 않는다. 실행 전에 셸로 읽혀야 한다:
#      set -a; source .env; set +a
#    (forge 는 .env 를 자동으로 읽으므로 forge script 에는 필요 없다)

# ─── 개인키 ──────────────────────────────────────────────────────────────────
# 전부 GIWA Sepolia 전용 데모 키다. 실자산이 있는 키를 넣지 말 것.

# 배포자 — forge script 가 자동으로 읽는다. 컨트랙트 배포·tKRW 민팅(MINTER_ROLE).
PRIVATE_KEY=

# 주인 EOA — 도장 보유 + 7702 코드 심긴 주소. 위임 서명·철회에 쓴다.
# 대시보드 마법사(Rabby)로 서명하면 CLI 에는 필요 없다.
OWNER_PRIVATE_KEY=

# 에이전트 — 결제 리딤을 브로드캐스트한다. 데몬·pay·agent·e2e 가 요구한다.
AGENT_PRIVATE_KEY=

# 두 번째 에이전트 (선택) — 대시보드에 에이전트를 둘 띄워볼 때만.
# 코드가 자동으로 읽지는 않는다.
AGENT2_PRIVATE_KEY=

# ─── 주소 (선택) ─────────────────────────────────────────────────────────────
# 비우면 packages/delegation/src/addresses.ts 의 기본값을 쓴다.

# 가맹처 A — 결제 수신처
MERCHANT_A=

# 공격 시나리오의 미검증 수신처. Dojang 에서 걸려야 하는 주소다.
ATTACKER=

# 이미 배포된 스택을 재사용할 때만 (forge script 가 읽는다).
# TOKEN_ADDRESS 를 넘기면 DeployErc7710 이 초기 발행을 건너뛴다.
TOKEN_ADDRESS=
GATE_ADDRESS=
REGISTRY_ADDRESS=

# ─── RPC (선택) ──────────────────────────────────────────────────────────────
# 비우면 공개 Flashblocks RPC(https://sepolia-rpc-flashblocks.giwa.io)를 쓴다.
# e2e 를 자주 돌리면 공개 RPC 가 `over rate limit` 을 내므로 전용 엔드포인트가 낫다.
RPC_URL=

# ─── 에이전트 데몬 (선택) ────────────────────────────────────────────────────

# 대시보드 출처 — 데몬 CORS 허용 목록에 더한다.
# 비우면 http://localhost:5173 · http://127.0.0.1:5173 만 허용한다.
DASHBOARD_ORIGIN=

# 데몬 쓰기 API(/inject · /pay-now) 인증 토큰.
# ⚠️ 데몬을 터널(ngrok · cloudflared)로 노출한다면 **반드시 설정할 것.**
#    CORS 는 브라우저만 막는다 — curl 은 그냥 통과하므로, 토큰이 없으면
#    누구나 /inject 를 호출할 수 있다. 대시보드 쪽에는 같은 값을
#    VITE_DAEMON_TOKEN 으로 넣는다.
DAEMON_TOKEN=

# ─── LLM 모드 (선택) ─────────────────────────────────────────────────────────
# `pnpm -F @jipsa/agent agent -- --mode claude` 로 실제 LLM 이 작업을 판단한다.
# 없으면 스크립트 모드로 동작한다 (온체인 동작은 동일하다).
ANTHROPIC_API_KEY=
# 기본값 claude-sonnet-5
CLAUDE_MODEL=

# ─── 대시보드 (선택) ─────────────────────────────────────────────────────────
# Vite 는 VITE_ 접두사만 클라이언트에 노출한다. 값이 브라우저 번들에 그대로
# 들어가므로 비밀을 넣지 말 것. 대시보드용은 apps/dashboard/.env.local 에 둔다.

# GIWA Sepolia RPC — 비우면 공개 Flashblocks RPC
VITE_RPC_URL=
# up.id 해석용 이더리움 **메인넷** RPC (up.id 는 메인넷 ENS 서브도메인이다).
# 비우면 https://ethereum-rpc.publicnode.com
VITE_MAINNET_RPC_URL=
# 데몬 주소. 비우면 localhost 에서 열었을 때만 http://127.0.0.1:8787 을 쓴다.
# 원격은 HTTPS 터널 주소여야 한다 (HTTPS 페이지에서 http 는 혼합 콘텐츠로 막힌다).
# "" 로 두면 데몬 연동을 완전히 끈다.
VITE_DAEMON_URL=
# 위 DAEMON_TOKEN 과 같은 값
VITE_DAEMON_TOKEN=
