# 대시보드 환경변수 템플릿
#
# 사용법: cp apps/dashboard/.env.example apps/dashboard/.env.local
#
# ⚠️ **저장소 루트의 `.env` 로는 동작하지 않는다.** Vite 는 `envDir` 기본값이
#    자기 프로젝트 루트(= apps/dashboard)라서 루트 `.env` 를 읽지 않는다.
#    실측으로 확인했다 — 루트에 넣은 VITE_ 값은 번들에 들어가지 않는다.
#    루트 `.env` 를 읽게 만들 수도 있지만(`envDir`), 그 파일에는 개인키가 있어
#    이름을 VITE_ 로 잘못 붙이는 순간 브라우저 번들에 실린다. 그래서 분리해 둔다.
#
# ⚠️ VITE_ 접두사가 붙은 값은 **브라우저 번들에 그대로 들어간다.** 비밀을 넣지 말 것.

# GIWA Sepolia RPC — 비우면 공개 Flashblocks RPC
# (https://sepolia-rpc-flashblocks.giwa.io)
VITE_RPC_URL=

# up.id 해석용 이더리움 **메인넷** RPC (up.id 는 메인넷 ENS 서브도메인이다).
# 비우면 https://ethereum-rpc.publicnode.com
VITE_MAINNET_RPC_URL=

# 에이전트 데몬 주소.
# 비우면 localhost 에서 열었을 때만 http://127.0.0.1:8787 을 쓴다.
# 원격은 HTTPS 터널 주소여야 한다 (HTTPS 페이지에서 http 는 혼합 콘텐츠로 막힌다).
# "" 로 두면 데몬 연동을 완전히 끈다.
VITE_DAEMON_URL=

# 루트 .env 의 DAEMON_TOKEN 과 **같은 값**.
# 데몬을 터널로 노출할 때만 필요하다.
VITE_DAEMON_TOKEN=
